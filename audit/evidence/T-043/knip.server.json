{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "server.js!",
    "app.js!",
    "scripts/**/*.{js,mjs}",
    "__tests__/**/*.{js,mjs}"
  ],
  "project": [
    "**/*.{js,mjs}!",
    "!node_modules/**",
    "!public/**",
    "!migrations/**"
  ],
  "ignoreExportsUsedInFile": true
}
