{
  "expo": {
    "name": "Rehearsly",
    "slug": "rehearsal-calendar-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "rehearsalapp",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rehearsal.app",
      "buildNumber": "2",
      "associatedDomains": ["applinks:rehearsly.me"],
      "config": {
        "googleSignIn": {
          "reservedClientId": "com.googleusercontent.apps.187810235800-9pp30fhn7kekvcranjrij9fib5kl8od0"
        }
      },
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "rehearsalapp",
              "com.googleusercontent.apps.187810235800-9pp30fhn7kekvcranjrij9fib5kl8od0"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsUsageDescription": "Rehearsly adds your rehearsals to your calendar. From the calendars you pick it takes only the hours you are busy, never what your events are called.",
        "NSCalendarsFullAccessUsageDescription": "Rehearsly adds your rehearsals to your calendar. From the calendars you pick it takes only the hours you are busy, never what your events are called.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Rehearsly adds your rehearsals to your calendar.",
        "NSRemindersUsageDescription": "Rehearsly works only with your calendar and never asks for access to your reminders.",
        "NSRemindersFullAccessUsageDescription": "Rehearsly works only with your calendar and never asks for access to your reminders."
      }
    },
    "locales": {
      "en": "./locales/en.json",
      "ru": "./locales/ru.json",
      "es": "./locales/es.json",
      "de": "./locales/de.json"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rehearsal.app",
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rehearsly.me",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "rehearsalapp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#A855F7"
        }
      ],
      "expo-localization",
      "expo-calendar"
    ],
    "extra": {
      "eas": {
        "projectId": "3151ccee-abfe-4f07-925e-00004d2fade8"
      },
      "googleIosClientId": "187810235800-9pp30fhn7kekvcranjrij9fib5kl8od0.apps.googleusercontent.com",
      "googleAndroidClientId": "187810235800-dqfk1of6ork5c4pqtff7pi4srmlgo6ej.apps.googleusercontent.com",
      "googleWebClientId": "187810235800-q13jtdqimc8qeppacne0ma32i0anm14j.apps.googleusercontent.com"
    }
  }
}
