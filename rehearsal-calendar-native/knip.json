{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.ts!",
    "App.tsx!",
    "src/**/*.{test,spec}.{ts,tsx}",
    "src/__tests__/**/*.{ts,tsx,js}",
    "e2e/**/*.{js,mjs}"
  ],
  "project": [
    "src/**/*.{ts,tsx,js}!",
    "e2e/**/*.{js,mjs}"
  ],
  "ignore": [
    "e2e/out/**"
  ],
  "expo": {
    "config": ["app.json"]
  },
  "metro": {
    "config": ["metro.config.js"]
  },
  "jest": {
    "config": ["jest.config.js"]
  },
  "ignoreExportsUsedInFile": true
}
