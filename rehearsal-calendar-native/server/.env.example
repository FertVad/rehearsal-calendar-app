# Server Configuration
NODE_ENV=development
PORT=3001
DEBUG=true
LOG_REQUESTS=true

# JWT Configuration
# CRITICAL: JWT_SECRET is REQUIRED in production (server will fail to start without it)
# For development: optional, but strongly recommended to set
# Generate: openssl rand -base64 32
# Example: JWT_SECRET=your-generated-secret-here
JWT_SECRET=
JWT_EXPIRES_IN=30d
REFRESH_TOKEN_EXPIRES_IN=90d

# Database Configuration
# For development (SQLite):
# Leave DATABASE_URL empty or commented out

# For production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# OAuth Configuration (Google)
# Get these from Google Cloud Console → APIs & Services → Credentials
# Create OAuth 2.0 Client IDs for iOS, Android, and Web
GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com

# OAuth Configuration (Apple Sign-In)
# Get these from Apple Developer Portal
# Certificates, Identifiers & Profiles → Keys
APPLE_CLIENT_ID=com.rehearsal.app
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
# Paste the contents of your .p8 private key file here
# Or store the path to the .p8 file
APPLE_PRIVATE_KEY=

# AllPay Payment Configuration (Israeli Payment Provider)
# Get these from AllPay dashboard: https://www.allpay.co.il
# CRITICAL: ALLPAY_API_LOGIN and ALLPAY_API_KEY are REQUIRED for payment processing
# For development: Set ALLPAY_TEST_MODE=true to use test environment
# For production: Set ALLPAY_TEST_MODE=false
ALLPAY_API_LOGIN=your-allpay-api-login
ALLPAY_API_KEY=your-allpay-api-key
ALLPAY_TEST_MODE=true
# CRITICAL: Required for webhook signature verification
# Get from AllPay dashboard → Settings → Webhook Secret
ALLPAY_WEBHOOK_SECRET=your-webhook-secret

# Admin Dashboard
# CRITICAL: Password for /admin panel login
ADMIN_PASSWORD=your-admin-password

# Cron Job (Vercel Cron Jobs)
# CRITICAL: Required to protect /api/cron/recurring-billing endpoint
# Without this, the billing endpoint is open to anyone
# Generate: openssl rand -base64 32
CRON_SECRET=

# Server URL (used for invite links and payment redirects)
# In production: set to your Vercel deployment URL (e.g. https://your-app.vercel.app)
# In development: leave empty or set to http://localhost:3001
BASE_URL=

# Server host (default: 0.0.0.0 — required for physical device access)
HOST=0.0.0.0
