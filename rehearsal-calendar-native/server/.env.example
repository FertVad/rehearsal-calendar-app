# Server Configuration
NODE_ENV=development
PORT=3001
DEBUG=true
LOG_REQUESTS=true

# JWT Configuration
# CRITICAL: JWT_SECRET is REQUIRED in production (server will fail to start without it)
# For development: optional, but strongly recommended to set
# Generate: openssl rand -base64 32
# Example: JWT_SECRET=your-generated-secret-here
JWT_SECRET=
JWT_EXPIRES_IN=30d
REFRESH_TOKEN_EXPIRES_IN=90d

# Database Configuration
# For development (SQLite):
# Leave DATABASE_URL empty or commented out

# For production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# OAuth Configuration (Google)
# Get these from Google Cloud Console → APIs & Services → Credentials
# Create OAuth 2.0 Client IDs for iOS, Android, and Web
GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com

# OAuth Configuration (Apple Sign-In)
# Get these from Apple Developer Portal
# Certificates, Identifiers & Profiles → Keys
APPLE_CLIENT_ID=com.rehearsal.app
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
# Paste the contents of your .p8 private key file here
# Or store the path to the .p8 file
APPLE_PRIVATE_KEY=

# Admin Dashboard
# Option A (recommended): bcrypt hash of your password
# Generate: node -e "import('bcrypt').then(b => b.default.hash('yourpassword', 10).then(console.log))"
ADMIN_PASSWORD_HASH=
# Option B (legacy): plaintext password — less secure, avoid in production
ADMIN_PASSWORD=
# JWT secret for admin tokens (optional — falls back to JWT_SECRET)
# Generate: openssl rand -base64 32
ADMIN_JWT_SECRET=

# Cron Job (Vercel Cron Jobs)
# CRITICAL: Required to protect /api/cron/reminders (rehearsal push reminders)
# The endpoint is fail-closed — without this it answers 503 and reminders never send
# Generate: openssl rand -base64 32
CRON_SECRET=

# Server URL (used for invite links and universal links)
# In production: set to your Vercel deployment URL (e.g. https://your-app.vercel.app)
# In development: leave empty or set to http://localhost:3001
BASE_URL=

# Server host (default: 0.0.0.0 — required for physical device access)
HOST=0.0.0.0
